{
  "app": {
    "language": "it",
    "mode": "auto"
  },
  "watch": {
    "paths": [
      "C:/Users/USER/Downloads"
    ],
    "recursive": false,
    "settle_seconds": 2.0,
    "settle_max_seconds": 0,
    "ignore_globs": ["desktop.ini", "thumbs.db", ".ds_store", "~$*", ".*"]
  },
  "library": {
    "root": "C:/Users/USER/Downloads/Organizzati",
    "create_folders": true,
    "duplicate_strategy": "rename"
  },
  "rules": {
    "by_extension": {
      ".pdf": "Documenti/PDF",
      ".docx": "Documenti/Word",
      ".xlsx": "Documenti/Excel",
      ".jpg": "Immagini",
      ".png": "Immagini",
      ".zip": "Archivi"
    },
    "default_folder": "Altro"
  },
  "logging": {
    "level": "INFO",
    "file": "%LOCALAPPDATA%/FilesGoThere/logs/filesgothere.log",
    "max_bytes": 1048576,
    "backups": 3
  },
  "queue": {
    "enabled": true,
    "file": "%LOCALAPPDATA%/FilesGoThere/data/queue.jsonl"
  }
}
