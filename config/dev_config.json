{
  "app": {
    "language": "it",
    "mode": "manual"
  },
  "watch": {
    "paths": [],
    "recursive": false,
    "settle_seconds": 1.0
  },
  "library": {
    "root": "",
    "create_folders": false,
    "duplicate_strategy": "rename"
  },
  "rules": {
