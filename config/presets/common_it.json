{
  "app": {
    "language": "it",
    "mode": "manual"
  },
  "watch": {
    "paths": [
      "C:/Users/USER/Downloads"
    ],
    "recursive": false,
    "settle_seconds": 3.0
  },
  "library": {
    "root": "",
    "create_folders": true,
    "duplicate_strategy": "rename"
  },
  "rules": {
    "by_extension": {
      ".mp4": "Video",
      ".mkv": "Video",
      ".mov": "Video",
      ".avi": "Video",
      ".mp3": "Audio",
      ".wav": "Audio",
      ".flac": "Audio",
      ".txt": "Testi",
      ".pdf": "Documenti",
      ".doc": "Documenti",
      ".docx": "Documenti",
      ".ppt": "Presentazioni",
      ".pptx": "Presentazioni",
      ".xls": "Fogli di calcolo",
      ".xlsx": "Fogli di calcolo",
      ".csv": "Fogli di calcolo",
      ".jpg": "Immagini",
      ".jpeg": "Immagini",
      ".png": "Immagini",
      ".gif": "Immagini",
      ".webp": "Immagini",
      ".zip": "Archivi",
      ".7z": "Archivi",
      ".rar": "Archivi",
      ".tar": "Archivi",
      ".gz": "Archivi",
      ".exe": "Programmi",
      ".msi": "Programmi",
      ".bin": "Test Files",
      ".json": "Download Test"
    },
    "default_folder": "Altro"
  },
  "logging": {
    "level": "INFO",
    "file": "%LOCALAPPDATA%/FilesGoThere/logs/filesgothere.log",
    "max_bytes": 1048576,
    "backups": 3
  },
  "queue": {
    "enabled": true,
    "file": "%LOCALAPPDATA%/FilesGoThere/data/queue.jsonl"
  }
}
