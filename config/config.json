{
  "app": {
    "language": "en",
    "mode": "auto",
    "theme": "light",
    "focus_on_startup": false,
    "focus_on_download_complete": false,
    "minimize_to_tray": true
  },
  "watch": {
    "paths": [],
    "recursive": false,
    "settle_seconds": 3.0,
    "settle_max_seconds": 0,
    "ignore_globs": [
      "desktop.ini",
      "thumbs.db",
      ".ds_store",
      "~$*",
      ".*"
    ]
  },
  "library": {
    "root": "",
    "create_folders": true,
    "duplicate_strategy": "rename"
  },
  "rules": {
    "by_extension": {
      ".mp4": "Video",
      ".mkv": "Video",
      ".mov": "Video",
      ".avi": "Video",
      ".mp3": "Audio",
      ".wav": "Audio",
      ".flac": "Audio",
      ".txt": "Testi",
      ".pdf": "Documenti",
      ".doc": "Documenti",
      ".docx": "Documenti",
      ".ppt": "Presentazioni",
      ".pptx": "Presentazioni",
      ".xls": "Fogli di calcolo",
      ".xlsx": "Fogli di calcolo",
      ".csv": "Fogli di calcolo",
      ".jpg": "Immagini",
      ".jpeg": "Immagini",
      ".png": "Immagini",
      ".gif": "Immagini",
      ".webp": "Immagini",
      ".zip": "Archivi",
      ".7z": "Archivi",
      ".rar": "Archivi",
      ".tar": "Archivi",
      ".gz": "Archivi",
      ".exe": "Programmi",
      ".msi": "Programmi"
    },
    "default_folder": "Altro"
  },
  "logging": {
    "level": "INFO",
    "file": "%LOCALAPPDATA%/FilesGoThere/logs/filesgothere.log",
    "max_bytes": 1048576,
    "backups": 3
  },
  "queue": {
    "enabled": true,
    "file": "%LOCALAPPDATA%/FilesGoThere/data/queue.jsonl"
  }
}